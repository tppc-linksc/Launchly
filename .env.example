# Launchly local development defaults
LAUNCHLY_APP_PORT=8080
LAUNCHLY_WEB_PORT=5173
LAUNCHLY_DB_HOST=localhost
LAUNCHLY_DB_PORT=5432
LAUNCHLY_DB_NAME=launchly
LAUNCHLY_DB_USER=launchly
LAUNCHLY_DB_PASSWORD=launchly_dev_password
LAUNCHLY_JWT_SECRET=dev-jwt-hmac-key-change-in-production-at-least-48chars-JWT
LAUNCHLY_ENCRYPTION_KEY=dev-enc-seed-change-in-production-at-least-48chars-KEY
# Lite is the default: it supports the control plane and existing OCI image deployments.
# Set COMPOSE_PROFILES=builder to enable local BuildKit source builds on a 2 vCPU / 4 GB+ host.
COMPOSE_PROFILES=
LAUNCHLY_POSTGRES_MEMORY_LIMIT=512m
LAUNCHLY_API_MEMORY_LIMIT=384m
LAUNCHLY_WORKER_MEMORY_LIMIT=384m
LAUNCHLY_BUILDKIT_MEMORY_LIMIT=1024m
# Never reuse the JWT key here. During a key rotation, keep prior values only until re-encryption completes.
# LAUNCHLY_ENCRYPTION_PREVIOUS_KEYS=old-key-1,old-key-2
LAUNCHLY_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# GitHub App values are required only for CI gates/private repositories.
# LAUNCHLY_GITHUB_APP_ID=
# LAUNCHLY_GITHUB_APP_PRIVATE_KEY_BASE64=
# Optional Docker config JSON used only by the build worker when pushing private images.
# Keep this file mode 0600 in production and never commit the real value.
# LAUNCHLY_REGISTRY_AUTH_JSON={"auths":{"registry.example.com":{"auth":"base64-user-colon-password"}}}
